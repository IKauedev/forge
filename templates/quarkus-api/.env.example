# Copie para .env (ignorado pelo git) e ajuste se precisar.
# forge:if db!=none
DB_NAME=starter_api
DB_USER=starter_api
DB_PASSWORD=starter_api
# forge:end
APP_PORT=8080
# forge:if auth!=none
# Emissor do JWT em produção (o JWKS é lido de <issuer>/.well-known/jwks.json)
JWT_ISSUER_URI=https://issuer.example.invalid
# Claim com as roles (padrão roles; no Cognito, cognito:groups)
# JWT_ROLES_CLAIM=roles
# forge:end
