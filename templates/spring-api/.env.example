#~ JWT_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_EXAMPLE
# forge:else
# forge:if auth=jwt
JWT_ISSUER_URI=https://issuer.example.invalid
# forge:end
